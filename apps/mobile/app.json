{
  "expo": {
    "name": "ManaCost",
    "slug": "manacost",
    "scheme": "manacost",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.manacost.app"
    },
    "android": {
      "package": "com.manacost.app",
      "versionCode": 1,
      "backgroundColor": "#0B0F19",
      "navigationBar": {
        "backgroundColor": "#0B0F19",
        "barStyle": "light-content"
      },
      "splash": {
        "backgroundColor": "#0B0F19",
        "resizeMode": "contain",
        "mdpi": "./assets/splash-icon.png",
        "hdpi": "./assets/splash-icon.png",
        "xhdpi": "./assets/splash-icon.png",
        "xxhdpi": "./assets/splash-icon.png",
        "xxxhdpi": "./assets/splash-icon.png"
      },
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F19",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0B0F19",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "O ManaCost precisa de acesso à câmera para ler QR Codes de notas fiscais (NFC-e)."
        }
      ],
      "expo-image",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b1078482-6cfe-454c-8256-de8e9a1e29a7"
      }
    },
    "owner": "lucaslandgraf"
  }
}